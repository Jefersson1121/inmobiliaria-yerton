# Copia este archivo como .env.local y completa los valores.
# En Vercel: Project Settings > Environment Variables.

# URL pública del sitio (sin "/" al final). Se usa para sitemap y SEO.
NEXT_PUBLIC_SITE_URL=https://yerton-inmobiliaria.vercel.app

# Clave gratuita de https://web3forms.com (opcional).
# Si no se define, los formularios abren WhatsApp con el mensaje ya escrito.
NEXT_PUBLIC_WEB3FORMS_KEY=
